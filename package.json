{
  "name": "mmp",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "description": "Automatic GitLab code reviews, cumulative review memory, Jira team context and Mattermost notifications over MCP",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baekseunghak/Review-Bot-For-SSAFY.git"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test",
    "smoke": "node scripts/smoke.mjs",
    "webhook:serve": "node bin/gitlab-webhook.mjs",
    "worker:serve": "node bin/review-worker.mjs",
    "smoke:review": "node scripts/review-smoke.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.6.5"
  }
}
