# Copy to .env and fill your own values. Neither server loads this file automatically.
# Start with node --env-file=/absolute/path/.env <entrypoint> or supply process env.
# Keep actual secrets and team data out of Git. Use an absolute private data path.
MATTERMOST_MCP_DATA_DIR=
# Optional receiver settings; these do not register team member profiles.
REVIEWBOT_GITLAB_USERNAME=
REVIEWBOT_GITLAB_USER_ID=
REVIEWBOT_GITLAB_BOT_USER_ID=
REVIEWBOT_GITLAB_PROJECT_IDS=
REVIEWBOT_WEBHOOK_SECRET=
REVIEWBOT_PORT=8765
# Jira Cloud: all four values are required for sync, weekly summaries and MR context.
# Use your own project key; no project is selected by default.
REVIEWBOT_JIRA_BASE_URL=
REVIEWBOT_JIRA_EMAIL=
REVIEWBOT_JIRA_API_TOKEN=
REVIEWBOT_JIRA_PROJECT_KEY=
# Automatic processing is opt-in. The receiver alone never runs a model.
# The host is the glab hostname, without https:// or a path.
REVIEWBOT_AUTO_REVIEW=0
REVIEWBOT_GITLAB_HOST=
# Logical channel whose saved webhook credentials are used for the author's DM.
# Register the author as a participant with GitLab/Mattermost mapping and
# create the review-complete convention before enabling this worker.
REVIEWBOT_MATTERMOST_CHANNEL=
# Native CLI executable; the worker reuses its existing login.
REVIEWBOT_REVIEW_COMMAND=claude
REVIEWBOT_REVIEW_TIMEOUT_MS=180000
# Local durable queue checks, not GitLab API polling.
REVIEWBOT_WORKER_INTERVAL_MS=5000
